# ==========================================
# 1. Terraform (حساس جداً - أمن البنية التحتية)
# ==========================================
# منع رفع ملفات الحالة التي قد تحتوي على باسورداف أو أسرار مكشوفة
*.tfstate
*.tfstate.backup
*.tfstate.lock.hcl

# منع رفع مجلدات العمل المحلية الخاصة بـ Terraform
.terraform/
.terraform.lock.hcl

# منع رفع ملفات المتغيرات الحساسة (إن وجدت مستقبلاً)
*.tfvars
*.tfvars.json
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# ==========================================
# 2. Python & Flask (بيئة التطوير والملفات المؤقتة)
# ==========================================
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.Python
env/
venv/
ENV/
*.env
.env

# ==========================================
# 3. Docker (ملفات النظام والبيانات الحية)
# ==========================================
# إذا كان لديك ملفات كاش أو Logs خاصة بـ Cowrie أو الـ Honeypot تظهر محلياً
cowrie_logs/
.docker/

# ==========================================
# 4. بيئات التطوير والأنظمة التشغيلية (OS & IDEs)
# ==========================================
.vscode/
.idea/
.DS_Store
Thumbs.db

# ==========================================
# 5. ملفات الميديا والأرشيف المضغوطة
# ==========================================
# Archives
*.7z
*.dmg
*.gz
*.iso
*.jar
*.rar
*.tar
*.zip

# Media
*.mp4
*.mp3
*.jpg
*.jpeg
*.png
*.gif